<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlanPeopleAvalonia.ViewModels"
             x:Class="PlanPeopleAvalonia.Views.SettingsComponents.SettingsSidebar"
             x:DataType="vm:SettingsViewModel">
    
    <Border Background="White" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto, *">
            <TextBlock Text="设置" FontSize="20" FontWeight="Bold" Margin="20,24,20,16" Foreground="#1A1A1A"/>
            
            <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" 
                     Background="Transparent" BorderThickness="0" Margin="10,0">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="#0078D4"/>
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected TextBlock">
                        <Setter Property="Foreground" Value="White"/>
                    </Style>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="16,12"/>
                        <Setter Property="Margin" Value="0,2"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>