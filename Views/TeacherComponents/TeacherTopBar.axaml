<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlanPeopleAvalonia.ViewModels"
             x:Class="PlanPeopleAvalonia.Views.TeacherComponents.TeacherTopBar"
             x:DataType="vm:TeacherViewModel">
    
    <Border Background="White" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*, Auto" Margin="16,12">
            <TextBlock Text="教师管理" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Click="OnEditClick" Padding="12,6" Background="Transparent">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" Width="14" Height="14" Foreground="#333"/>
                        <TextBlock Text="编辑" VerticalAlignment="Center" Foreground="#333"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteTeacherCommand}" Padding="12,6" Background="Transparent">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" Width="14" Height="14" Foreground="#E53935"/>
                        <TextBlock Text="删除选中" VerticalAlignment="Center" Foreground="#E53935"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AddTeacherCommand}" Padding="12,6" Background="#1976D2" Foreground="White">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="M12 5v14M5 12h14" Width="14" Height="14" Foreground="White"/>
                        <TextBlock Text="添加教师" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>