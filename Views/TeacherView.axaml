<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlanPeopleAvalonia.ViewModels"
             xmlns:comp="using:PlanPeopleAvalonia.Views.TeacherComponents"
             x:Class="PlanPeopleAvalonia.Views.TeacherView"
             x:DataType="vm:TeacherViewModel">
    
    <Grid RowDefinitions="Auto, *">
        <comp:TeacherTopBar Grid.Row="0" />

        <Grid Grid.Row="1" ColumnDefinitions="280, *">
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
                <comp:TeacherListView />
            </Border>
            <Border Grid.Column="1" Background="#F0F2F5">
                <comp:TeacherDetailView />
            </Border>
        </Grid>
    </Grid>
</UserControl>