<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlanPeopleAvalonia.ViewModels"
             xmlns:models="using:PlanPeopleAvalonia.Models"
             x:Class="PlanPeopleAvalonia.Views.ExamComponents.ExamListView"
             x:DataType="vm:ExamViewModel">
    
    <!-- 确保左侧有固定宽度的白色背景 -->
    <Border Background="White" Width="280">
        <Grid RowDefinitions="Auto, *">
            <TextBlock Text="考试列表" FontSize="14" FontWeight="Bold" Foreground="#666" Margin="16,16,16,8"/>
            
            <ListBox Name="ExamListBox" Grid.Row="1" 
                     ItemsSource="{Binding Exams}" 
                     SelectedItem="{Binding SelectedExam, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#F0F2F5"/>
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="#E3F2FD"/>
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Margin" Value="8,2"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ExamRecord">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#333"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Subject}" FontSize="12" Foreground="#1976D2"/>
                                <TextBlock Text="{Binding Date}" FontSize="12" Foreground="#888"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>