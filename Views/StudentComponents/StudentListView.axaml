<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlanPeopleAvalonia.ViewModels"
             xmlns:models="using:PlanPeopleAvalonia.Models"
             x:Class="PlanPeopleAvalonia.Views.StudentComponents.StudentListView"
             x:DataType="vm:StudentViewModel">
    
    <Grid RowDefinitions="Auto, *">
        <!-- 搜索框 -->
        <TextBox Name="SearchBox" Margin="12" Watermark="搜索学生姓名或学号..." 
                 Height="36" CornerRadius="6" Background="#F8F9FA" BorderBrush="#E0E0E0" />
        
        <!-- 学生列表 -->
        <ListBox Name="StudentListBox" Grid.Row="1" 
                 ItemsSource="{Binding Students}" 
                 SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0">
            
            <!-- 列表项样式 -->
            <ListBox.Styles>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="#F0F2F5"/>
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="4"/>
                    <Setter Property="Margin" Value="8,2"/>
                </Style>
            </ListBox.Styles>
            
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Student">
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="4,6">
                        <!-- 头像区 -->
                        <Border Width="44" Height="44" CornerRadius="22" Background="#E0E0E0" ClipToBounds="True">
                            <Panel>
                                <Image Source="{Binding PhotoPath}" Stretch="UniformToFill" 
                                       IsVisible="{Binding PhotoPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                <TextBlock Text="{Binding Name[0], FallbackValue='?'}" FontSize="20" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#666"
                                           IsVisible="{Binding PhotoPath, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                            </Panel>
                        </Border>
                        
                        <!-- 信息区 -->
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="#333"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Id}" FontSize="12" Foreground="#1976D2"/>
                                <TextBlock Text="{Binding Duty, FallbackValue='学生'}" FontSize="12" Foreground="#888"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>