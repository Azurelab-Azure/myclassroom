<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlanPeopleAvalonia.ViewModels"
             xmlns:comp="using:PlanPeopleAvalonia.Views.StudentComponents"
             x:Class="PlanPeopleAvalonia.Views.StudentView"
             x:DataType="vm:StudentViewModel">
    
    <Grid RowDefinitions="Auto, *">
        <!-- 1. 顶部工具栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*, Auto" Margin="16,12">
                <TextBlock Text="学生管理" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Click="OnEditClick" Padding="12,6" Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" Width="14" Height="14" Foreground="#333"/>
                            <TextBlock Text="编辑" VerticalAlignment="Center" Foreground="#333"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnDeleteClick" Padding="12,6" Background="Transparent">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" Width="14" Height="14" Foreground="#E53935"/>
                            <TextBlock Text="删除选中" VerticalAlignment="Center" Foreground="#E53935"/>
                        </StackPanel>
                    </Button>
                    <Button Click="OnAddClick" Padding="12,6" Background="#1976D2" Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="M12 5v14M5 12h14" Width="14" Height="14" Foreground="White"/>
                            <TextBlock Text="添加学生" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. 主内容区 -->
        <Grid Grid.Row="1" ColumnDefinitions="280, *">
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
                <comp:StudentListView Name="ListView" />
            </Border>
            
            <Border Grid.Column="1" Background="#F0F2F5">
                <comp:StudentDetailView Name="DetailView" />
            </Border>
        </Grid>
    </Grid>
</UserControl>