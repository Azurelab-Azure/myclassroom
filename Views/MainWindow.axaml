<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PlanPeopleAvalonia.ViewModels"
        x:Class="PlanPeopleAvalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PlanPeople v3.0" Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="White">
    
    <Grid ColumnDefinitions="240, *">
        
        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, *">
                
                <!-- Logo 区 -->
                <TextBlock Grid.Row="0" Text="PlanPeople" FontSize="22" FontWeight="Black" Margin="24,32,24,24" Foreground="#1A1A1A"/>
                
                <!-- 导航菜单 -->
                <ListBox Grid.Row="1" 
                         SelectedIndex="{Binding SelectedNavIndex, Mode=TwoWay}"
                         Background="Transparent" 
                         BorderThickness="0"
                         SelectionChanged="OnNavSelectionChanged">
                    
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#0078D4"/>
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Margin" Value="12,4"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected TextBlock">
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected Path">
                            <Setter Property="Fill" Value="White"/>
                        </Style>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="16,12"/>
                            <Setter Property="Margin" Value="12,2"/>
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </ListBox.Styles>

                    <!-- 首页 -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" Fill="#666" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Text="首页" FontSize="15" VerticalAlignment="Center" Foreground="#1A1A1A"/>
                        </StackPanel>
                    </ListBoxItem>
                    
                    <!-- 课表 -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Data="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z" Fill="#666" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Text="课表" FontSize="15" VerticalAlignment="Center" Foreground="#1A1A1A"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- 教师 -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" Fill="#666" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Text="教师" FontSize="15" VerticalAlignment="Center" Foreground="#1A1A1A"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- 学生 -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" Fill="#666" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Text="学生" FontSize="15" VerticalAlignment="Center" Foreground="#1A1A1A"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- 成绩 -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Data="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z" Fill="#666" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Text="成绩" FontSize="15" VerticalAlignment="Center" Foreground="#1A1A1A"/>
                        </StackPanel>
                    </ListBoxItem>

                    <!-- 设置 -->
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Fill="#666" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock Text="设置" FontSize="15" VerticalAlignment="Center" Foreground="#1A1A1A"/>
                        </StackPanel>
                    </ListBoxItem>

                </ListBox>
            </Grid>
        </Border>

        <!-- 右侧内容区 -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
    </Grid>
</Window>